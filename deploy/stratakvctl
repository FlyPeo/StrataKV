#!/usr/bin/env sh
# Compatibility command set backed entirely by native local processes.
set -eu

deploy_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# 与 stratakv-server 一致的双模式判定:上级存在 CMakeLists.txt 为源码树模式,
# 否则为发行包模式(scripts/ 之下,init 不可用)。
if [ -f "${deploy_dir}/../CMakeLists.txt" ]; then
  deployment_mode=source
else
  deployment_mode=package
fi
project=${STRATAKV_PROJECT:-stratakv-local}
tso_port=${STRATAKV_TSO_PORT:-26300}

usage() {
  cat <<'EOF'
Usage: bash deploy/stratakvctl <command> [args]

Commands:
  init                         Build native executables.
  up                           Start the local 3-node cluster.
  down                         Stop local processes and preserve data.
  status                       Show local process and Region status.
  verify                       Verify nodes and Leaders.
  restart-node <node-N>        Restart one local physical node process.
  logs [node-N]                Show native process logs.
  reset                        Stop and delete this local project's data.

Set STRATAKV_PROJECT and STRATAKV_TSO_PORT to select another local project.
Client access is provided exclusively via the native C++ SDK (stratakv_sdk).
Docker is not used.
EOF
}

server() { bash "${deploy_dir}/stratakv-server" "$@" --project "$project"; }

case "${1:-}" in
  init)
    if [ "$deployment_mode" = package ]; then
      echo "init is not available in a release package: it contains no source tree." >&2
      exit 2
    fi
    build_dir="${deploy_dir}/../build/stratakv/release"
    cmake -S "${deploy_dir}/.." -B "$build_dir" -DCMAKE_BUILD_TYPE=Release
    cmake --build "$build_dir" -j"$(nproc)"
    ;;
  up) server up --tso-port "$tso_port" ;;
  down) server down ;;
  status) server status ;;
  verify) server verify ;;
  restart-node)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    server restart-node --node "$2"
    ;;
  logs)
    if [ "$#" -eq 2 ]; then server logs --node "$2"; else server logs; fi
    ;;
  reset) server reset ;;
  help|-h|--help|'') usage ;;
  *) echo "Unsupported local command: $1" >&2; usage >&2; exit 2 ;;
esac
