#!/usr/bin/env sh
# Build and operate a persistent StrataKV cluster as native local processes.
set -eu

deploy_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "${deploy_dir}/.." && pwd)

usage() {
  cat <<'EOF'
Usage:
  bash deploy/stratakv-server up [options]
  bash deploy/stratakv-server run [options]
  bash deploy/stratakv-server config [options]
  bash deploy/stratakv-server rebuild [--project NAME]
  bash deploy/stratakv-server restart-node [--project NAME] --node node-N
  bash deploy/stratakv-server restart-tso [--project NAME] --node tso-N
  bash deploy/stratakv-server status [--project NAME]
  bash deploy/stratakv-server verify [--project NAME]
  bash deploy/stratakv-server logs [--project NAME] [--node node-N]
  bash deploy/stratakv-server local-data [--project NAME] [--node node-N] [--prefix PREFIX]
  bash deploy/stratakv-server down [--project NAME]
  bash deploy/stratakv-server reset [--project NAME]

Options:
  --nodes N          Physical local processes. Default: 3.
  --replicas R       Raft replicas in every Region. Default: 3.
  --project NAME     Persistent deployment name. Default: stratakv-local.
  --gateway-port P   Local HTTP Gateway port. Default: 8080.
  --tso-port P       First of three TSO control-plane ports. Default: 26300.
  --tso-range-size N Timestamp values reserved per TSO Raft proposal. Default: 4096.
  --gateway-runtime MODE
                     Gateway concurrency mode: thread or fiber. Default: thread.
  --gateway-workers N
                     IOManager workers in fiber mode. Default: 4.
  --gateway-request-workers N
                     Native blocking-request workers in fiber mode. Default: 16.
  --raft-log-gc-threshold N
                     Soft GC threshold in reclaimable entries. Default: 50.
  --raft-log-gc-count-limit N
                     Force GC at this many log entries. Default: 196608.
  --raft-log-gc-size-limit B
                     Force GC at this approximate log size. Default: 201326592 (192 MiB).
  --raft-log-gc-tick-interval-ms N
                     Raft log GC check period. Default: 3000.
  --max-raft-state B Deprecated alias for --raft-log-gc-size-limit.
  --node NAME        Member selected by restart-node/restart-tso/logs/local-data.
  --prefix PREFIX    Key prefix used by local-data.
  --no-build         Reuse the current bin/ executables.

The local topology has three fixed Regions: ["",h), [h,p), [p,+inf).
Runtime data, PIDs and logs live under deploy/runtime/<project>/.
No Docker command, container, image or volume is used.
EOF
}

is_uint() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
is_project() { case "$1" in ''|*[!A-Za-z0-9_-]*) return 1 ;; *) return 0 ;; esac; }

command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
nodes=3
replicas=3
project=stratakv-local
gateway_port=8080
tso_port=26300
tso_range_size=4096
gateway_runtime=thread
gateway_workers=4
gateway_request_workers=16
raft_log_gc_threshold=50
raft_log_gc_count_limit=196608
raft_log_gc_size_limit=201326592
raft_log_gc_tick_interval_ms=3000
selected_node=all
inspect_prefix=
build_enabled=true

while [ "$#" -gt 0 ]; do
  case "$1" in
    --nodes) nodes=${2:?--nodes requires a value}; shift 2 ;;
    --replicas) replicas=${2:?--replicas requires a value}; shift 2 ;;
    --project) project=${2:?--project requires a value}; shift 2 ;;
    --gateway-port) gateway_port=${2:?--gateway-port requires a value}; shift 2 ;;
    --tso-port) tso_port=${2:?--tso-port requires a value}; shift 2 ;;
    --tso-range-size) tso_range_size=${2:?--tso-range-size requires a value}; shift 2 ;;
    --gateway-runtime) gateway_runtime=${2:?--gateway-runtime requires a value}; shift 2 ;;
    --gateway-workers) gateway_workers=${2:?--gateway-workers requires a value}; shift 2 ;;
    --gateway-request-workers) gateway_request_workers=${2:?--gateway-request-workers requires a value}; shift 2 ;;
    --raft-log-gc-threshold) raft_log_gc_threshold=${2:?--raft-log-gc-threshold requires a value}; shift 2 ;;
    --raft-log-gc-count-limit) raft_log_gc_count_limit=${2:?--raft-log-gc-count-limit requires a value}; shift 2 ;;
    --raft-log-gc-size-limit) raft_log_gc_size_limit=${2:?--raft-log-gc-size-limit requires a value}; shift 2 ;;
    --raft-log-gc-tick-interval-ms) raft_log_gc_tick_interval_ms=${2:?--raft-log-gc-tick-interval-ms requires a value}; shift 2 ;;
    --max-raft-state) raft_log_gc_size_limit=${2:?--max-raft-state requires a value}; shift 2 ;;
    --node) selected_node=${2:?--node requires a value}; shift 2 ;;
    --prefix) inspect_prefix=${2:?--prefix requires a value}; shift 2 ;;
    --no-build) build_enabled=false; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

is_project "$project" || { echo "--project may use only letters, digits, _ and -." >&2; exit 2; }
runtime_dir="${deploy_dir}/runtime/${project}"
regions_file="${runtime_dir}/regions.conf"
settings_file="${runtime_dir}/runtime.conf"
pids_dir="${runtime_dir}/pids"
logs_dir="${runtime_dir}/logs"
node_bin="${repo_dir}/bin/stratakv-node"
gateway_bin="${repo_dir}/bin/stratakv-gateway"
tso_bin="${repo_dir}/bin/stratakv-tso"
admin_bin="${repo_dir}/bin/stratakv-admin"

load_settings() {
  [ -f "$settings_file" ] || {
    echo "No local deployment for project ${project}. Run stratakv-server up first." >&2
    return 1
  }
  nodes=$(sed -n 's/^nodes=//p' "$settings_file")
  replicas=$(sed -n 's/^replicas=//p' "$settings_file")
  gateway_port=$(sed -n 's/^gateway_port=//p' "$settings_file")
  saved_tso_port=$(sed -n 's/^tso_port=//p' "$settings_file")
  [ -z "$saved_tso_port" ] || tso_port=$saved_tso_port
  saved_tso_range_size=$(sed -n 's/^tso_range_size=//p' "$settings_file")
  [ -z "$saved_tso_range_size" ] || tso_range_size=$saved_tso_range_size
  saved_gateway_runtime=$(sed -n 's/^gateway_runtime=//p' "$settings_file")
  [ -z "$saved_gateway_runtime" ] || gateway_runtime=$saved_gateway_runtime
  saved_gateway_workers=$(sed -n 's/^gateway_workers=//p' "$settings_file")
  [ -z "$saved_gateway_workers" ] || gateway_workers=$saved_gateway_workers
  saved_gateway_request_workers=$(sed -n 's/^gateway_request_workers=//p' "$settings_file")
  [ -z "$saved_gateway_request_workers" ] || gateway_request_workers=$saved_gateway_request_workers
  saved_raft_log_gc_threshold=$(sed -n 's/^raft_log_gc_threshold=//p' "$settings_file")
  [ -z "$saved_raft_log_gc_threshold" ] || raft_log_gc_threshold=$saved_raft_log_gc_threshold
  saved_raft_log_gc_count_limit=$(sed -n 's/^raft_log_gc_count_limit=//p' "$settings_file")
  [ -z "$saved_raft_log_gc_count_limit" ] || raft_log_gc_count_limit=$saved_raft_log_gc_count_limit
  saved_raft_log_gc_size_limit=$(sed -n 's/^raft_log_gc_size_limit=//p' "$settings_file")
  if [ -n "$saved_raft_log_gc_size_limit" ]; then
    raft_log_gc_size_limit=$saved_raft_log_gc_size_limit
  else
    saved_max_raft_state=$(sed -n 's/^max_raft_state=//p' "$settings_file")
    [ -z "$saved_max_raft_state" ] || raft_log_gc_size_limit=$saved_max_raft_state
  fi
  saved_raft_log_gc_tick_interval_ms=$(sed -n 's/^raft_log_gc_tick_interval_ms=//p' "$settings_file")
  [ -z "$saved_raft_log_gc_tick_interval_ms" ] || raft_log_gc_tick_interval_ms=$saved_raft_log_gc_tick_interval_ms
}

validate_topology() {
  is_uint "$nodes" && [ "$nodes" -gt 0 ] || { echo "--nodes must be a positive integer." >&2; exit 2; }
  is_uint "$replicas" && [ "$replicas" -gt 0 ] || { echo "--replicas must be a positive integer." >&2; exit 2; }
  is_uint "$gateway_port" && [ "$gateway_port" -gt 0 ] && [ "$gateway_port" -le 65535 ] || {
    echo "--gateway-port must be between 1 and 65535." >&2; exit 2;
  }
  is_uint "$tso_port" && [ "$tso_port" -gt 0 ] && [ "$tso_port" -le 65535 ] || {
    echo "--tso-port must be between 1 and 65535." >&2; exit 2;
  }
  [ "$tso_port" -le 65533 ] || { echo "--tso-port must leave room for three consecutive ports." >&2; exit 2; }
  is_uint "$tso_range_size" && [ "$tso_range_size" -gt 0 ] || {
    echo "--tso-range-size must be a positive integer." >&2; exit 2;
  }
  tso_index=0
  while [ "$tso_index" -lt 3 ]; do
    candidate=$((tso_port + tso_index))
    [ "$candidate" -ne "$gateway_port" ] && [ "$candidate" -ne 26200 ] &&
      [ "$candidate" -ne 26201 ] && [ "$candidate" -ne 26202 ] || {
      echo "TSO ports must not overlap the Gateway or node RPC ports." >&2; exit 2;
    }
    tso_index=$((tso_index + 1))
  done
  case "$gateway_runtime" in fiber|thread) ;;
    *) echo "--gateway-runtime must be fiber or thread." >&2; exit 2 ;;
  esac
  is_uint "$gateway_workers" && [ "$gateway_workers" -gt 0 ] && [ "$gateway_workers" -le 256 ] || {
    echo "--gateway-workers must be between 1 and 256." >&2; exit 2;
  }
  is_uint "$gateway_request_workers" && [ "$gateway_request_workers" -gt 0 ] && [ "$gateway_request_workers" -le 256 ] || {
    echo "--gateway-request-workers must be between 1 and 256." >&2; exit 2;
  }
  is_uint "$raft_log_gc_threshold" && [ "$raft_log_gc_threshold" -gt 0 ] || {
    echo "--raft-log-gc-threshold must be a positive integer." >&2; exit 2;
  }
  is_uint "$raft_log_gc_count_limit" && [ "$raft_log_gc_count_limit" -gt 0 ] || {
    echo "--raft-log-gc-count-limit must be a positive integer." >&2; exit 2;
  }
  is_uint "$raft_log_gc_size_limit" && [ "$raft_log_gc_size_limit" -gt 0 ] || {
    echo "--raft-log-gc-size-limit must be a positive integer." >&2; exit 2;
  }
  is_uint "$raft_log_gc_tick_interval_ms" && [ "$raft_log_gc_tick_interval_ms" -gt 0 ] || {
    echo "--raft-log-gc-tick-interval-ms must be a positive integer." >&2; exit 2;
  }
  [ "$nodes" -eq 3 ] && [ "$replicas" -eq 3 ] || {
    echo "Native local deployment currently requires --nodes 3 --replicas 3." >&2
    exit 2
  }
  case "$selected_node" in all|node-0|node-1|node-2|tso-0|tso-1|tso-2) ;;
    *) echo "--node must be node-0..2, tso-0..2 or all." >&2; exit 2 ;;
  esac
}

build_programs() {
  [ "$build_enabled" = true ] || return 0
  asan=${STRATAKV_ENABLE_ASAN:-OFF}
  build_dir="${repo_dir}/build/stratakv/release"
  cmake -S "$repo_dir" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Release \
    -DSTRATAKV_ENABLE_ASAN="$asan"
  cmake --build "$build_dir" -j"$(nproc)" \
    --target stratakv-node stratakv-tso stratakv-admin stratakv-gateway stratakv-client stratakv-test-reliability
}

write_regions() {
  mkdir -p "$runtime_dir"
  {
    echo "# Generated by deploy/stratakv-server for native local processes."
    echo "region.count=3"
  } >"$regions_file"
  region=0
  while [ "$region" -lt 3 ]; do
    case "$region" in
      0) region_id=100; start_key=; end_key=h ;;
      1) region_id=101; start_key=h; end_key=p ;;
      2) region_id=102; start_key=p; end_key= ;;
    esac
    {
      echo
      echo "region.${region}.id=${region_id}"
      echo "region.${region}.start_key=${start_key}"
      echo "region.${region}.end_key=${end_key}"
      echo "region.${region}.peer.count=3"
    } >>"$regions_file"
    peer=0
    while [ "$peer" -lt 3 ]; do
      # Every Region on one physical node shares the NodeServer listener.
      port=$((26200 + peer))
      {
        echo "region.${region}.peer.${peer}.node_id=${peer}"
        echo "region.${region}.peer.${peer}.host=127.0.0.1"
        echo "region.${region}.peer.${peer}.port=${port}"
      } >>"$regions_file"
      peer=$((peer + 1))
    done
    region=$((region + 1))
  done
  {
    echo "project=${project}"
    echo "nodes=3"
    echo "replicas=3"
    echo "gateway_port=${gateway_port}"
    echo "tso_port=${tso_port}"
    echo "tso_range_size=${tso_range_size}"
    echo "gateway_runtime=${gateway_runtime}"
    echo "gateway_workers=${gateway_workers}"
    echo "gateway_request_workers=${gateway_request_workers}"
    echo "raft_log_gc_threshold=${raft_log_gc_threshold}"
    echo "raft_log_gc_count_limit=${raft_log_gc_count_limit}"
    echo "raft_log_gc_size_limit=${raft_log_gc_size_limit}"
    echo "raft_log_gc_tick_interval_ms=${raft_log_gc_tick_interval_ms}"
  } >"$settings_file"
}

pid_file() { printf '%s/%s.pid' "$pids_dir" "$1"; }

managed_pid() {
  name=$1
  file=$(pid_file "$name")
  [ -f "$file" ] || return 1
  pid=$(sed -n '1p' "$file")
  is_uint "$pid" || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  expected=$node_bin
  [ "$name" = gateway ] && expected=$gateway_bin
  case "$name" in tso|tso-*) expected=$tso_bin ;; esac
  actual=$(readlink -f "/proc/${pid}/exe" 2>/dev/null || true)
  expected=$(readlink -f "$expected")
  # Replacing an executable while its process is alive makes procfs report
  # "/path/to/program (deleted)". It is still the managed process and must be
  # stopped; otherwise a rebuild can leave a stale server occupying the port.
  case "$actual" in
    "$expected"|"$expected (deleted)") ;;
    *) return 1 ;;
  esac
  printf '%s' "$pid"
}

time_service_endpoints() {
  printf '127.0.0.1:%s,127.0.0.1:%s,127.0.0.1:%s' "$tso_port" "$((tso_port + 1))" "$((tso_port + 2))"
}

start_tso_node() {
  name=$1
  node_id=${name#tso-}
  if managed_pid "$name" >/dev/null 2>&1; then
    echo "${name} is already running." >&2
    return 1
  fi
  data_dir="${runtime_dir}/${name}"
  mkdir -p "$pids_dir" "$logs_dir" "$data_dir"
  rm -f "${data_dir}/run_data/tso_raft_status.json"
  log="${logs_dir}/${name}.log"
  (
    cd "$data_dir"
    setsid "$tso_bin" \
      --node-id "$node_id" \
      --peers "$(time_service_endpoints)" \
      --state-file "${data_dir}/tso.state" \
      --range-size "$tso_range_size" >>"$log" 2>&1 </dev/null &
    echo "$!" >"$(pid_file "$name")"
  )
}

migrate_legacy_tso_state() {
  legacy_state="${runtime_dir}/tso/tso.state"
  [ -f "$legacy_state" ] || return 0
  for name in tso-0 tso-1 tso-2; do
    data_dir="${runtime_dir}/${name}"
    target="${data_dir}/tso.state"
    if [ ! -f "$target" ]; then
      mkdir -p "$data_dir"
      cp "$legacy_state" "$target"
    fi
  done
}

start_node() {
  name=$1
  node_id=${name#node-}
  if managed_pid "$name" >/dev/null 2>&1; then
    echo "${name} is already running." >&2
    return 1
  fi
  mkdir -p "$pids_dir" "$logs_dir" "${runtime_dir}/${name}"
  rm -f "${runtime_dir}/${name}"/run_data/raft_status_region_*.json \
    "${runtime_dir}/${name}"/run_data/raft_log_region_*.json
  log="${logs_dir}/${name}.log"
  (
    cd "${runtime_dir}/${name}"
    setsid "$node_bin" \
      --node-id "$node_id" \
      --regions-config "$regions_file" \
      --raft-log-gc-threshold "$raft_log_gc_threshold" \
      --raft-log-gc-count-limit "$raft_log_gc_count_limit" \
      --raft-log-gc-size-limit "$raft_log_gc_size_limit" \
      --raft-log-gc-tick-interval-ms "$raft_log_gc_tick_interval_ms" >>"$log" 2>&1 </dev/null &
    echo "$!" >"$(pid_file "$name")"
  )
}

start_gateway() {
  if managed_pid gateway >/dev/null 2>&1; then
    echo "gateway is already running." >&2
    return 1
  fi
  mkdir -p "$pids_dir" "$logs_dir" "${runtime_dir}/gateway"
  log="${logs_dir}/gateway.log"
  (
    cd "${runtime_dir}/gateway"
    setsid "$gateway_bin" \
      --regions-config "$regions_file" \
      --host 127.0.0.1 \
      --port "$gateway_port" \
      --tso-endpoints "$(time_service_endpoints)" \
      --runtime "$gateway_runtime" \
      --workers "$gateway_workers" \
      --request-workers "$gateway_request_workers" >>"$log" 2>&1 </dev/null &
    echo "$!" >"$(pid_file gateway)"
  )
}

stop_process() {
  name=$1
  file=$(pid_file "$name")
  if ! pid=$(managed_pid "$name" 2>/dev/null); then
    rm -f "$file"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  attempt=0
  while [ "$attempt" -lt 10 ] && managed_pid "$name" >/dev/null 2>&1; do
    sleep 1
    attempt=$((attempt + 1))
  done
  if managed_pid "$name" >/dev/null 2>&1; then
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$file"
}

leader_count() {
  region_id=$1
  count=0
  for file in "${runtime_dir}"/node-*/run_data/raft_status_region_"${region_id}"_*.json; do
    [ -f "$file" ] || continue
    if grep -q '"isLeader":true' "$file"; then count=$((count + 1)); fi
  done
  printf '%s' "$count"
}

tso_leader_count() {
  count=0
  for name in tso-0 tso-1 tso-2; do
    managed_pid "$name" >/dev/null 2>&1 || continue
    file="${runtime_dir}/${name}/run_data/tso_raft_status.json"
    if [ -f "$file" ] && grep -q '"isLeader":true' "$file"; then count=$((count + 1)); fi
  done
  printf '%s' "$count"
}

wait_for_tso() {
  attempt=0
  while [ "$attempt" -lt 60 ]; do
    running=0
    for name in tso-0 tso-1 tso-2; do
      if managed_pid "$name" >/dev/null 2>&1; then running=$((running + 1)); fi
    done
    if [ "$running" -eq 3 ] && [ "$(tso_leader_count)" -eq 1 ]; then return 0; fi
    [ "$running" -eq 3 ] || {
      echo "A TSO control-plane member exited during startup. See ${logs_dir}." >&2
      return 1
    }
    attempt=$((attempt + 1))
    sleep 1
  done
  echo "TSO control plane did not elect a Leader within 60 seconds." >&2
  return 1
}

caught_up_count() {
  count=0
  for file in "${runtime_dir}"/node-*/run_data/raft_status_region_*.json; do
    [ -f "$file" ] || continue
    commit_index=$(sed -n 's/.*"commitIndex":\([0-9][0-9]*\).*/\1/p' "$file")
    last_applied=$(sed -n 's/.*"lastApplied":\([0-9][0-9]*\).*/\1/p' "$file")
    last_log_index=$(sed -n 's/.*"lastLogIndex":\([0-9][0-9]*\).*/\1/p' "$file")
    if [ -n "$commit_index" ] && [ "$commit_index" = "$last_applied" ] &&
       [ "$commit_index" = "$last_log_index" ]; then
      count=$((count + 1))
    fi
  done
  printf '%s' "$count"
}

wait_for_cluster() {
  attempt=0
  while [ "$attempt" -lt 300 ]; do
    running=0
    for name in node-0 node-1 node-2; do
      if managed_pid "$name" >/dev/null 2>&1; then running=$((running + 1)); fi
    done
    statuses=$(find "${runtime_dir}"/node-*/run_data -maxdepth 1 \
      -name 'raft_status_region_*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
    if [ "$running" -eq 3 ] && [ "$statuses" -eq 9 ] &&
       [ "$(leader_count 100)" -eq 1 ] &&
       [ "$(leader_count 101)" -eq 1 ] &&
       [ "$(leader_count 102)" -eq 1 ] &&
       [ "$(caught_up_count)" -eq 9 ]; then
      return 0
    fi
    [ "$running" -eq 3 ] || {
      echo "A local StrataKV node exited during startup. See ${logs_dir}." >&2
      return 1
    }
    attempt=$((attempt + 1))
    sleep 1
  done
  echo "Local Raft cluster did not elect and catch up all three Regions within 300 seconds." >&2
  return 1
}

wait_for_gateway() {
  attempt=0
  while [ "$attempt" -lt 60 ]; do
    managed_pid gateway >/dev/null 2>&1 || {
      echo "Gateway exited during startup. See ${logs_dir}/gateway.log." >&2
      return 1
    }
    if curl -fsS "http://127.0.0.1:${gateway_port}/healthz" >/dev/null 2>&1; then return 0; fi
    attempt=$((attempt + 1))
    sleep 1
  done
  echo "Gateway did not become healthy within 60 seconds." >&2
  return 1
}

generate() {
  validate_topology
  write_regions
  echo "Generated native topology: project=${project} nodes=3 replicas-per-region=3"
  echo "Regions: ${regions_file}"
  echo "Runtime: ${runtime_dir}"
}

start_all() {
  generate
  build_programs
  # Upgrade an existing single-node TSO deployment before binding tso-0 to its port.
  stop_process tso
  migrate_legacy_tso_state
  for name in tso-0 tso-1 tso-2; do start_tso_node "$name"; done
  wait_for_tso
  for name in node-0 node-1 node-2; do start_node "$name"; done
  wait_for_cluster
  start_gateway
  wait_for_gateway
  echo "StrataKV local cluster is ready: gateway=http://127.0.0.1:${gateway_port} tso=$(time_service_endpoints)"
}

stop_all() {
  stop_process gateway
  stop_process node-2
  stop_process node-1
  stop_process node-0
  stop_process tso-2
  stop_process tso-1
  stop_process tso-0
  stop_process tso
}

show_status() {
  load_settings
  for name in tso-0 tso-1 tso-2 node-0 node-1 node-2 gateway; do
    if pid=$(managed_pid "$name" 2>/dev/null); then
      echo "${name}: running pid=${pid}"
    else
      echo "${name}: stopped"
    fi
  done
  echo "gateway=http://127.0.0.1:${gateway_port}"
  echo "tso=$(time_service_endpoints) leaders=$(tso_leader_count)"
  echo "gateway-runtime=${gateway_runtime} io-workers=${gateway_workers} request-workers=${gateway_request_workers}"
  echo "raft-log-gc threshold=${raft_log_gc_threshold} count-limit=${raft_log_gc_count_limit} size-limit=${raft_log_gc_size_limit} tick-ms=${raft_log_gc_tick_interval_ms}"
  for region_id in 100 101 102; do
    echo "region-${region_id}: leaders=$(leader_count "$region_id")"
  done
}

verify_cluster() {
  load_settings
  for name in tso-0 tso-1 tso-2 node-0 node-1 node-2 gateway; do
    managed_pid "$name" >/dev/null || { echo "Verification failed: ${name} is stopped." >&2; return 1; }
  done
  [ "$(tso_leader_count)" -eq 1 ] || {
    echo "Verification failed: TSO control plane does not have exactly one Leader." >&2
    return 1
  }
  for region_id in 100 101 102; do
    [ "$(leader_count "$region_id")" -eq 1 ] || {
      echo "Verification failed: Region ${region_id} does not have exactly one Leader." >&2
      return 1
    }
  done
  curl -fsS "http://127.0.0.1:${gateway_port}/healthz" >/dev/null
  echo "Verification passed: 3 TSO members, 3 local nodes, 9 Region peers, 4 Raft Leaders and Gateway are healthy."
}

restart_one() {
  load_settings
  validate_topology
  case "$selected_node" in node-0|node-1|node-2) ;;
    *) echo "restart-node requires --node node-0, node-1 or node-2." >&2; exit 2 ;;
  esac
  stop_process "$selected_node"
  start_node "$selected_node"
  attempt=0
  while [ "$attempt" -lt 60 ]; do
    if managed_pid "$selected_node" >/dev/null 2>&1; then
      files=$(find "${runtime_dir}/${selected_node}/run_data" -maxdepth 1 \
        -name 'raft_status_region_*.json' -type f 2>/dev/null | wc -l | tr -d ' ')
      if [ "$files" -eq 3 ] &&
         [ "$(leader_count 100)" -eq 1 ] &&
         [ "$(leader_count 101)" -eq 1 ] &&
         [ "$(leader_count 102)" -eq 1 ]; then
        echo "Restarted ${selected_node} as a local process and restored all Region leaders."
        return 0
      fi
    else
      echo "${selected_node} exited during restart. See ${logs_dir}/${selected_node}.log." >&2
      return 1
    fi
    attempt=$((attempt + 1))
    sleep 1
  done
  echo "${selected_node} did not recover within 60 seconds." >&2
  return 1
}

restart_tso() {
  load_settings
  validate_topology
  case "$selected_node" in tso-0|tso-1|tso-2) ;;
    *) echo "restart-tso requires --node tso-0, tso-1 or tso-2." >&2; exit 2 ;;
  esac
  stop_process "$selected_node"
  start_tso_node "$selected_node"
  wait_for_tso
  echo "Restarted ${selected_node}; the TSO control plane has exactly one Leader."
}

show_logs() {
  load_settings
  case "$selected_node" in
    all) tail -n 100 "${logs_dir}"/*.log ;;
    *) tail -n 200 "${logs_dir}/${selected_node}.log" ;;
  esac
}

local_data() {
  load_settings
  validate_topology
  for name in node-0 node-1 node-2; do
    [ "$selected_node" = all ] || [ "$selected_node" = "$name" ] || continue
    node_id=${name#node-}
    port=$((26200 + node_id))
    for region_id in 100 101 102; do
      echo "=== ${name} / Region ${region_id} / 127.0.0.1:${port} ==="
      STRATAKV_ENDPOINTS="127.0.0.1:${port}" STRATAKV_REGION_ID="$region_id" \
        "$admin_bin" local-list "$inspect_prefix"
    done
  done
}

case "$command" in
  up) start_all ;;
  run)
    start_all
    cleanup() { trap - EXIT INT TERM; stop_all; }
    trap cleanup EXIT INT TERM
    echo "Following local Gateway log; press Ctrl+C to stop the cluster."
    tail -n 20 -f "${logs_dir}/gateway.log"
    ;;
  config) generate ;;
  rebuild)
    load_settings
    stop_all
    build_enabled=true
    start_all
    ;;
  restart-node) restart_one ;;
  restart-tso) restart_tso ;;
  status) show_status ;;
  verify) verify_cluster ;;
  logs) show_logs ;;
  local-data) local_data ;;
  down)
    load_settings
    stop_all
    echo "Stopped local StrataKV project ${project}; data preserved in ${runtime_dir}."
    ;;
  reset)
    load_settings
    stop_all
    case "$runtime_dir" in "${deploy_dir}/runtime/"*) rm -rf -- "$runtime_dir" ;; *) exit 1 ;; esac
    echo "Deleted local StrataKV project ${project}."
    ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
