#!/usr/bin/env sh
# Run the native StrataKV client against a locally managed Gateway.
set -eu

deploy_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "${deploy_dir}/.." && pwd)

usage() {
  cat <<'EOF'
Usage:
  bash deploy/stratakv-client start [--project NAME]
  bash deploy/stratakv-client shell [--project NAME]
  bash deploy/stratakv-client batch [--project NAME] <file>
  bash deploy/stratakv-client put [--project NAME] <key> <value>
  bash deploy/stratakv-client get [--project NAME] <key>
  bash deploy/stratakv-client delete [--project NAME] <key>
  bash deploy/stratakv-client status [--project NAME]

The client runs directly from bin/stratakv-client and connects to the local
Gateway recorded in deploy/runtime/<project>/runtime.conf. Docker is not used.
EOF
}

command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
project=stratakv-local
if [ "${1:-}" = "--project" ]; then
  project=${2:?--project requires a value}
  shift 2
fi
case "$project" in ''|*[!A-Za-z0-9_-]*) echo "Invalid --project." >&2; exit 2 ;; esac

runtime_dir="${deploy_dir}/runtime/${project}"
settings_file="${runtime_dir}/runtime.conf"
client_bin="${repo_dir}/bin/stratakv-client"

if [ "$command" != help ] && [ "$command" != -h ] && [ "$command" != --help ]; then
  [ -f "$settings_file" ] || {
    echo "No local deployment for project ${project}. Run stratakv-server up first." >&2
    exit 1
  }
  [ -x "$client_bin" ] || { echo "Missing ${client_bin}; build the project first." >&2; exit 1; }
  gateway_port=$(sed -n 's/^gateway_port=//p' "$settings_file")
  gateway="http://127.0.0.1:${gateway_port}"
fi

run_client() {
  STRATAKV_GATEWAY="$gateway" "$client_bin" "$@"
}

case "$command" in
  start|status)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    curl -fsS "${gateway}/healthz"
    echo
    ;;
  shell)
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    STRATAKV_GATEWAY="$gateway" exec "$client_bin" shell
    ;;
  batch)
    [ "$#" -eq 1 ] && [ -f "$1" ] || { echo "batch requires one command file." >&2; exit 2; }
    run_client shell <"$1"
    ;;
  put)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    run_client put "$1" "$2"
    ;;
  get|delete)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    run_client "$command" "$1"
    ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac
